    {
      "name": "4. Quotes Management",
      "item": [
        {
          "name": "1. Create Quote (Only Quote Fields - No Corridors)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Basic Remittance Proposal\",\n  \"partnerName\": \"FinTech Innovations Ltd\",\n  \"contractLength\": 12,\n  \"status\": \"draft\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes"]
            },
            "description": "Scenario 1: Creates a bare quote without attached corridors. Financials default to 0.00 and audit log is recorded."
          },
          "response": []
        },
        {
          "name": "2. Create Quote (With Corridors - Default Rates Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Proposal with Default Corridor Rates\",\n  \"partnerName\": \"Acme Payments Group\",\n  \"contractLength\": 24,\n  \"status\": \"draft\",\n  \"corridors\": [\n    {\n      \"corridorId\": \"10001\"\n    },\n    {\n      \"corridorId\": \"10002\"\n    },\n    {\n      \"corridorId\": \"10003\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes"]
            },
            "description": "Scenario 2: Creates a quote attached with corridors where all fee values automatically fall back to standard corridor catalog rates."
          },
          "response": []
        },
        {
          "name": "3. Create Quote (With Corridors - Custom Fee Overrides)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"High Volume Custom Rate Proposal\",\n  \"partnerName\": \"Global Enterprise FX\",\n  \"contractLength\": 36,\n  \"status\": \"in_review\",\n  \"corridors\": [\n    {\n      \"corridorId\": \"10001\",\n      \"overrideStdFixedFeeUsd\": \"1.8500\",\n      \"overrideVariableFeePercentage\": \"0.4500\"\n    },\n    {\n      \"corridorId\": \"10005\",\n      \"overrideStdFixedFeeUsd\": \"2.1000\",\n      \"overrideVariableFeePercentage\": \"0.6000\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes"]
            },
            "description": "Scenario 3: Creates a quote attached with corridors using full custom fee overrides (fixed and variable fee %)."
          },
          "response": []
        },
        {
          "name": "4. Create Quote (Mixed Overrides - Partial & Defaults)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mixed Corridor Deal 2026\",\n  \"partnerName\": \"Nexus Cross-Border Payments\",\n  \"contractLength\": 12,\n  \"status\": \"draft\",\n  \"corridors\": [\n    {\n      \"corridorId\": \"10001\",\n      \"overrideStdFixedFeeUsd\": \"1.5000\"\n    },\n    {\n      \"corridorId\": \"10002\",\n      \"overrideVariableFeePercentage\": \"0.3500\"\n    },\n    {\n      \"corridorId\": \"10010\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes"]
            },
            "description": "Scenario 4: Creates a quote where one corridor has a fixed fee override, another has variable % override, and another uses default corridor rates."
          },
          "response": []
        },
        {
          "name": "List All Quotes",
          "request": {
            "method": "GET",
