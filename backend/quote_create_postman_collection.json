              "mode": "raw",
              "raw": "{\n  \"version\": 3,\n  \"corridors\": [\n    {\n      \"corridorId\": \"10001\",\n      \"overrideStdFixedFeeUsd\": \"2.7500\",\n      \"overrideVariableFeePercentage\": \"0.6000\"\n    },\n    {\n      \"corridorId\": \"10002\",\n      \"overrideStdFixedFeeUsd\": \"1.5000\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
