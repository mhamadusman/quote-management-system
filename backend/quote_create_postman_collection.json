        {
          "name": "Update Quote (Scalar Fields Only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": 1,\n  \"name\": \"Updated Remittance Proposal\",\n  \"partnerName\": \"Acme Global Enterprise\",\n  \"contractLength\": 24,\n  \"status\": \"in_review\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes/{{quoteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes", "{{quoteId}}"]
            },
            "description": "Updates only quote scalar fields (name, partnerName, contractLength, status) with optimistic lock version. Executed in exactly 2 DB queries and logs audit trail."
          },
          "response": []
        },
        {
          "name": "Delete Quote",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes/{{quoteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes", "{{quoteId}}"]
            },
            "description": "Deletes a quote and cascades removal of pivot corridors, recording an audit log entry."
          },
          "response": []
        }
